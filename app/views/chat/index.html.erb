<% content_for(:title, "Kimi Chat") %>

<style>
  * { box-sizing: border-box; }
  body { margin: 0; background: #f3f4f6; font-family: "Segoe UI", "Microsoft YaHei", sans-serif; }

  /* ===== 整体双栏布局 ===== */
  .app { display: flex; height: 100vh; }

  /* ===== 左侧会话侧边栏 ===== */
  #sidebar {
    width: 260px; flex-shrink: 0; background: #111827; color: #e5e7eb;
    display: flex; flex-direction: column;
    transition: transform .2s ease;
  }
  #sidebar .new-chat-btn {
    margin: 14px 12px; padding: 10px 12px; border: 1px solid #374151; border-radius: 8px;
    background: #4f46e5; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer;
    text-align: center; width: calc(100% - 24px);
  }
  #sidebar .new-chat-btn:hover { background: #4338ca; }
  #sessionList { flex: 1; overflow-y: auto; padding: 0 8px 12px; }
  .session-item {
    position: relative; padding: 9px 34px 9px 12px; border-radius: 8px; cursor: pointer;
    margin-bottom: 2px; color: #d1d5db;
  }
  .session-item:hover { background: #1f2937; }
  .session-item.active { background: #374151; color: #fff; }
  .session-item .s-title {
    font-size: 13px; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .session-item .s-time { font-size: 11px; color: #9ca3af; margin-top: 2px; }
  .session-item .s-del {
    position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
    display: none; border: none; background: transparent; color: #9ca3af;
    font-size: 15px; cursor: pointer; padding: 2px 4px; border-radius: 4px; line-height: 1;
  }
  .session-item:hover .s-del { display: block; }
  .session-item .s-del:hover { color: #f87171; background: #1f2937; }
  #sessionList .empty-tip { font-size: 12px; color: #6b7280; text-align: center; padding: 20px 8px; }

  /* ===== 右侧聊天区 ===== */
  .chat-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; background: #fff; box-shadow: 0 0 12px rgba(0,0,0,.06); }
  header { padding: 14px 20px; border-bottom: 1px solid #e5e7eb; font-weight: 600; display: flex; align-items: center; justify-content: space-between; }
  header .left { display: flex; align-items: center; gap: 10px; }
  header .menu-btn {
    display: none; border: 1px solid #d1d5db; background: #fff; border-radius: 6px;
    font-size: 16px; padding: 3px 9px; cursor: pointer; color: #374151; line-height: 1.3;
  }
  header .nav-link { font-size: 13px; font-weight: 400; color: #4f46e5; cursor: pointer; border: 1px solid #c7d2fe; border-radius: 6px; padding: 4px 10px; background: #fff; text-decoration: none; }
  header .nav-link:hover { background: #eef2ff; }
  #messages { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .msg { max-width: 80%; padding: 10px 14px; border-radius: 12px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; font-size: 14px; }
  .msg.user { align-self: flex-end; background: #4f46e5; color: #fff; border-bottom-right-radius: 4px; }
  .msg.bot { align-self: flex-start; background: #f3f4f6; color: #111827; border-bottom-left-radius: 4px; }
  /* bot 消息按 Markdown 渲染，不再保留 pre-wrap 的原始换行 */
  .msg.bot { white-space: normal; }
  .msg.bot > :first-child { margin-top: 0; }
  .msg.bot > :last-child { margin-bottom: 0; }
  .msg.bot p { margin: 8px 0; }
  .msg.bot h1, .msg.bot h2, .msg.bot h3, .msg.bot h4, .msg.bot h5, .msg.bot h6 { margin: 12px 0 6px; line-height: 1.4; }
  .msg.bot h1 { font-size: 20px; }
  .msg.bot h2 { font-size: 18px; }
  .msg.bot h3 { font-size: 16px; }
  .msg.bot h4, .msg.bot h5, .msg.bot h6 { font-size: 14px; }
  .msg.bot ul, .msg.bot ol { margin: 6px 0; padding-left: 22px; }
  .msg.bot li { margin: 2px 0; }
  .msg.bot table { border-collapse: collapse; margin: 8px 0; font-size: 13px; }
  .msg.bot th, .msg.bot td { border: 1px solid #d1d5db; padding: 5px 10px; }
  .msg.bot th { background: #e5e7eb; font-weight: 600; }
  .msg.bot tbody tr:nth-child(even) { background: #e9eaee; }
  .msg.bot pre { background: #1f2937; color: #e5e7eb; border-radius: 8px; padding: 10px 12px; overflow-x: auto; margin: 8px 0; }
  .msg.bot pre code { background: transparent; color: inherit; padding: 0; }
  .msg.bot code { background: #e5e7eb; border-radius: 4px; padding: 1px 5px; font-size: 13px; font-family: Consolas, "Courier New", monospace; }
  .msg.bot blockquote { margin: 8px 0; padding: 2px 12px; border-left: 3px solid #9ca3af; color: #4b5563; }
  /* AI 回答中的数据图表（Chart.js canvas） */
  .msg.bot .chart-container { max-width: 100%; height: 320px; background: #fff; border-radius: 8px; padding: 12px; margin: 8px 0; border: 1px solid #e5e7eb; }
  .msg.bot .chart-container canvas { max-width: 100%; }
  .msg.error { align-self: flex-start; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
  .msg.thinking { color: #6b7280; font-style: italic; }
  form { display: flex; gap: 10px; padding: 14px 20px; border-top: 1px solid #e5e7eb; }
  #input { flex: 1; border: 1px solid #d1d5db; border-radius: 8px; padding: 10px 12px; font-size: 14px; outline: none; }
  #input:focus { border-color: #4f46e5; }
  button.send { background: #4f46e5; color: #fff; border: none; border-radius: 8px; padding: 10px 18px; font-size: 14px; cursor: pointer; }
  button.send:disabled { background: #a5b4fc; cursor: not-allowed; }
  .sources { align-self: flex-start; max-width: 80%; font-size: 12px; color: #6b7280; }
  .sources summary { cursor: pointer; color: #4f46e5; }
  .sources ul { margin: 4px 0 0; padding-left: 18px; }

  /* ===== 窄屏：侧边栏默认隐藏，汉堡按钮开合 ===== */
  @media (max-width: 767px) {
    #sidebar { position: fixed; left: 0; top: 0; bottom: 0; z-index: 30; transform: translateX(-100%); }
    #sidebar.open { transform: translateX(0); box-shadow: 4px 0 16px rgba(0,0,0,.3); }
    header .menu-btn { display: block; }
  }
</style>

<div class="app">
  <aside id="sidebar">
    <button type="button" class="new-chat-btn" id="newChatBtn">＋ 新会话</button>
    <div id="sessionList"></div>
  </aside>

  <div class="chat-wrap">
    <header>
      <span class="left">
        <button type="button" class="menu-btn" id="menuBtn" title="会话列表">☰</button>
        <span>Kimi Chat（k3）</span>
      </span>
      <a class="nav-link" href="/databases">数据源</a>
    </header>
    <div id="messages"></div>
    <form id="form">
      <input id="input" placeholder="输入消息，回车发送…" autocomplete="off" autofocus>
      <button type="submit" class="send" id="sendBtn">发送</button>
    </form>
  </div>
</div>

<script src="/vendor/marked.min.js"></script>
<script src="/vendor/purify.min.js"></script>
<script src="/vendor/chart.umd.min.js"></script>
<script src="/js/markdown-render.js"></script>
<script src="/js/chart-render.js"></script>
<script>
  const messages = document.getElementById('messages');
  const form = document.getElementById('form');
  const input = document.getElementById('input');
  const sendBtn = document.getElementById('sendBtn');
  const sidebar = document.getElementById('sidebar');
  const sessionList = document.getElementById('sessionList');
  const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

  // session_id 存的是 ChatSession 主键 id
  let sessionId = localStorage.getItem('kimi_chat_session_id') || null;
  let knownCount = 0; // 已渲染到页面上的消息条数

  function addMessage(text, cls) {
    const div = document.createElement('div');
    div.className = 'msg ' + cls;
    if (cls.split(' ').includes('bot')) {
      // bot 消息按 Markdown 渲染（marked 解析 + DOMPurify 过滤 XSS），
      // 其中的 ```chart 代码块渲染为 Chart.js 图表（需在 innerHTML 设置后再挂载）
      const rendered = renderMessageWithCharts(text);
      div.innerHTML = rendered.html;
      messages.appendChild(div);
      mountCharts(rendered.charts);
      messages.scrollTop = messages.scrollHeight;
      return div;
    } else {
      div.textContent = text;
    }
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
  }

  // 可折叠小字展示本次回答引用的数据来源
  function addSources(sources) {
    if (!sources || !sources.length) return;
    const details = document.createElement('details');
    details.className = 'sources';
    const summary = document.createElement('summary');
    summary.textContent = '数据来源（' + sources.length + '）';
    details.appendChild(summary);
    const ul = document.createElement('ul');
    sources.forEach((s) => {
      const li = document.createElement('li');
      li.textContent = (s.type === 'database' ? '数据库：' : '文件：') + s.name;
      ul.appendChild(li);
    });
    details.appendChild(ul);
    messages.appendChild(details);
    messages.scrollTop = messages.scrollHeight;
  }

  // 渲染服务器返回的消息列表中尚未显示的部分
  function renderMessages(list) {
    for (let i = knownCount; i < list.length; i++) {
      const m = list[i];
      addMessage(m.content, m.role === 'user' ? 'user' : 'bot');
      if (m.sources && m.sources.length) addSources(m.sources);
    }
    knownCount = list.length;
  }

  async function fetchHistory() {
    const res = await fetch('/chat/history?session_id=' + encodeURIComponent(sessionId));
    if (!res.ok) return null;
    return await res.json();
  }

  // ===== 侧边栏：会话列表 =====

  // ISO 时间转相对时间（如"3 天前"）
  function relativeTime(iso) {
    const then = new Date(iso).getTime();
    if (isNaN(then)) return '';
    const diff = Math.max(0, Date.now() - then);
    const min = Math.floor(diff / 60000);
    if (min < 1) return '刚刚';
    if (min < 60) return min + ' 分钟前';
    const hour = Math.floor(min / 60);
    if (hour < 24) return hour + ' 小时前';
    const day = Math.floor(hour / 24);
    if (day < 30) return day + ' 天前';
    const month = Math.floor(day / 30);
    if (month < 12) return month + ' 个月前';
    return Math.floor(month / 12) + ' 年前';
  }

  function renderSessionList(list) {
    sessionList.innerHTML = '';
    if (!list.length) {
      const tip = document.createElement('div');
      tip.className = 'empty-tip';
      tip.textContent = '暂无历史会话';
      sessionList.appendChild(tip);
      return;
    }
    list.forEach((s) => {
      const item = document.createElement('div');
      item.className = 'session-item' + (String(s.id) === String(sessionId) ? ' active' : '');
      item.dataset.id = s.id;

      const title = document.createElement('div');
      title.className = 's-title';
      title.textContent = s.title || ('会话 ' + s.id);
      title.title = s.preview || s.title || '';

      const time = document.createElement('div');
      time.className = 's-time';
      time.textContent = relativeTime(s.updated_at) + ' · ' + s.message_count + ' 条消息';

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 's-del';
      del.title = '删除会话';
      del.textContent = '✕';
      del.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteSession(s.id, item);
      });

      item.appendChild(title);
      item.appendChild(time);
      item.appendChild(del);
      item.addEventListener('click', () => switchSession(s.id));
      sessionList.appendChild(item);
    });
  }

  async function loadSessions() {
    try {
      const res = await fetch('/chat/sessions');
      if (!res.ok) return;
      renderSessionList(await res.json());
    } catch (e) { /* 列表加载失败不影响聊天 */ }
  }

  // 切换到某个历史会话：重置聊天区并加载其消息
  async function switchSession(id) {
    if (String(id) === String(sessionId)) { closeSidebarOnMobile(); return; }
    sessionId = String(id);
    localStorage.setItem('kimi_chat_session_id', sessionId);
    messages.innerHTML = '';
    knownCount = 0;
    sessionList.querySelectorAll('.session-item').forEach((el) => {
      el.classList.toggle('active', el.dataset.id === String(id));
    });
    closeSidebarOnMobile();
    const data = await fetchHistory();
    if (data) renderMessages(data.messages || []);
    input.focus();
  }

  async function deleteSession(id, itemEl) {
    if (!confirm('确定删除该会话及其全部消息吗？')) return;
    const res = await fetch('/chat/sessions/' + encodeURIComponent(id), {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': csrfToken }
    });
    if (!res.ok) return;
    itemEl.remove();
    if (!sessionList.querySelector('.session-item')) loadSessions();
    // 删除的是当前会话：同时清空聊天区
    if (String(id) === String(sessionId)) {
      sessionId = null;
      localStorage.removeItem('kimi_chat_session_id');
      messages.innerHTML = '';
      knownCount = 0;
    }
  }

  // 开启新会话（侧边栏按钮）：仅清空聊天区，等第一条消息发出后由后端创建会话
  function startNewChat() {
    sessionId = null;
    localStorage.removeItem('kimi_chat_session_id');
    messages.innerHTML = '';
    knownCount = 0;
    sessionList.querySelectorAll('.session-item.active').forEach((el) => el.classList.remove('active'));
    closeSidebarOnMobile();
    input.focus();
  }

  function closeSidebarOnMobile() {
    if (window.innerWidth < 768) sidebar.classList.remove('open');
  }

  document.getElementById('newChatBtn').addEventListener('click', startNewChat);
  document.getElementById('menuBtn').addEventListener('click', () => sidebar.classList.toggle('open'));

  // 页面加载：拉取会话列表 + 恢复上次会话
  (async () => {
    loadSessions();
    if (!sessionId) return;
    const data = await fetchHistory();
    if (!data) {
      sessionId = null;
      localStorage.removeItem('kimi_chat_session_id');
      return;
    }
    renderMessages(data.messages || []);
  })();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const prompt = input.value.trim();
    if (!prompt) return;

    const isNewSession = !sessionId; // 本条消息会在后端创建新会话

    addMessage(prompt, 'user');
    knownCount += 1;
    input.value = '';
    sendBtn.disabled = true;
    const thinking = addMessage('Kimi 思考中…（复杂问题可能需要 1 分钟左右）', 'bot thinking');

    try {
      const res = await fetch('/chat/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({ prompt, session_id: sessionId })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || ('请求失败: ' + res.status));

      sessionId = data.session_id;
      localStorage.setItem('kimi_chat_session_id', sessionId);
      // 新会话已创建：刷新侧边栏列表，让新条目（含后端生成的标题）出现并高亮
      if (isNewSession) loadSessions();

      // 后台任务已启动，轮询历史直到出现助手回复（最多等 5 分钟）
      const deadline = Date.now() + 5 * 60 * 1000;
      let done = false;
      while (!done && Date.now() < deadline) {
        await new Promise((r) => setTimeout(r, 2500));
        const hist = await fetchHistory();
        if (hist && hist.messages.length > knownCount) {
          thinking.remove();
          renderMessages(hist.messages);
          done = true;
        }
      }
      if (!done) {
        thinking.remove();
        addMessage('等待超时：任务仍在后台执行，刷新页面可查看结果。', 'error');
      }
    } catch (err) {
      thinking.remove();
      addMessage('网络错误: ' + err.message, 'error');
    }

    sendBtn.disabled = false;
    input.focus();
  });
</script>
