<% content_for(:title, "数据源管理") %>

<style>
  * { box-sizing: border-box; }
  body { margin: 0; background: #f3f4f6; font-family: "Segoe UI", "Microsoft YaHei", sans-serif; }
  .page-wrap { max-width: 900px; margin: 0 auto; min-height: 100vh; background: #fff; box-shadow: 0 0 12px rgba(0,0,0,.06); }
  header { padding: 14px 20px; border-bottom: 1px solid #e5e7eb; font-weight: 600; display: flex; align-items: center; justify-content: space-between; }
  header .nav-link { font-size: 13px; font-weight: 400; color: #4f46e5; text-decoration: none; border: 1px solid #c7d2fe; border-radius: 6px; padding: 4px 10px; }
  header .nav-link:hover { background: #eef2ff; }
  main { padding: 20px; }
  .source-card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px 16px; margin-bottom: 14px; }
  .source-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .source-name { font-weight: 600; font-size: 15px; }
  .badge { font-size: 12px; border-radius: 4px; padding: 2px 8px; }
  .badge.adapter { background: #eef2ff; color: #4f46e5; }
  .badge.enabled { background: #ecfdf5; color: #047857; }
  .badge.disabled { background: #f3f4f6; color: #6b7280; }
  .badge.ok { background: #ecfdf5; color: #047857; }
  .badge.fail { background: #fef2f2; color: #b91c1c; }
  .source-meta { margin-top: 8px; font-size: 13px; color: #4b5563; line-height: 1.7; word-break: break-all; }
  .source-error { margin-top: 8px; font-size: 13px; color: #b91c1c; background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; padding: 8px 10px; }
  .tables { margin-top: 8px; font-size: 13px; color: #374151; }
  .tables summary { cursor: pointer; color: #4f46e5; }
  .tables ul { margin: 6px 0 0; padding-left: 20px; }
  .empty { color: #6b7280; font-size: 14px; text-align: center; padding: 40px 0; }
</style>

<div class="page-wrap">
  <header>
    <span>数据源管理</span>
    <a class="nav-link" href="/">返回聊天</a>
  </header>
  <main>
    <% if @sources.empty? %>
      <div class="empty">暂无配置的数据源，请编辑 config/enterprise_databases.yml</div>
    <% end %>

    <% @sources.each do |s| %>
      <div class="source-card">
        <div class="source-head">
          <span class="source-name"><%= s[:name] %></span>
          <span class="badge adapter"><%= s[:adapter] %></span>
          <% if s[:enabled] %>
            <span class="badge enabled">已启用</span>
            <% if s[:ok] %>
              <span class="badge ok">连接成功</span>
            <% else %>
              <span class="badge fail">连接失败</span>
            <% end %>
          <% else %>
            <span class="badge disabled">未启用</span>
          <% end %>
        </div>
        <div class="source-meta">
          地址：<%= s[:address] %> ｜ 单次最多返回 <%= s[:max_rows] %> 行
        </div>
        <% if s[:enabled] %>
          <% if s[:ok] %>
            <details class="tables">
              <summary>表清单（<%= s[:tables].size %>）</summary>
              <ul>
                <% s[:tables].each do |t| %>
                  <li><%= t %></li>
                <% end %>
              </ul>
            </details>
          <% else %>
            <div class="source-error">失败原因：<%= s[:error] %></div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
